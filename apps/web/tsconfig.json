{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@invoice-generator/ui/*": ["../../packages/ui/components/*/index.tsx"],
      "@invoice-generator/*": ["../../packages/*"]
    },
    "allowJs": false,
    "incremental": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
